[sub_resource type="Shader" id=11]
code = "shader_type canvas_item;
//a soft round dot in the rect's colour; core > 0 whitens its middle (the bar's glowing head)
uniform float core = 0.0;

void fragment() {
	float d = length(UV - vec2(0.5)) * 2.0;
	vec3 rgb = mix(vec3(1.0, 0.984, 0.902), COLOR.rgb, mix(1.0, smoothstep(0.0, 0.57, d), core));
	float a = 1.0 - smoothstep(mix(0.0, 0.57, core), 1.0, d);
	COLOR = vec4(rgb, COLOR.a * a);
}
"

[sub_resource type="ShaderMaterial" id=12]
shader = SubResource( 11 )
shader_param/core = 1.0

[sub_resource type="ShaderMaterial" id=13]
shader = SubResource( 11 )
shader_param/core = 0.0

[sub_resource type="Shader" id=14]
code = "shader_type canvas_item;
//the promotion's burst: a ring of thin rays (5 of every 22 degrees) fading out towards the rim
uniform vec4 ray_color : hint_color = vec4(1.0, 0.886, 0.588, 0.6);

void fragment() {
	vec2 p = UV - vec2(0.5);
	float r = length(p) * 2.0;
	float turn = atan(p.y, p.x) / 6.2831853 + 0.5;
	float ray = 1.0 - step(0.2273, fract(turn * 16.3636));
	float ring = smoothstep(0.36, 0.42, r) * (1.0 - smoothstep(0.42, 0.98, r));
	COLOR = vec4(ray_color.rgb, ray_color.a * ray * ring);
}
"

[sub_resource type="ShaderMaterial" id=15]
shader = SubResource( 14 )
shader_param/ray_color = Color( 1, 0.886, 0.588, 0.6 )

[sub_resource type="Shader" id=16]
code = "shader_type canvas_item;
//a bright band sweeping across the title's text; shine_pos is the band's centre as a share of the
//label's width, outside 0..1 there is no band
uniform float shine_pos = -1.0;
uniform float width = 354.0;
uniform vec4 shine_color : hint_color = vec4(1.0, 0.973, 0.863, 1.0);
varying float along;

void vertex() {
	along = VERTEX.x / width;
}

void fragment() {
	vec4 col = texture(TEXTURE, UV) * COLOR;
	float band = 1.0 - smoothstep(0.0, 0.12, abs(along - shine_pos));
	col.rgb = mix(col.rgb, shine_color.rgb, band);
	COLOR = col;
}
"

[sub_resource type="ShaderMaterial" id=17]
shader = SubResource( 16 )
shader_param/shine_pos = -1.0
shader_param/width = 354.0
shader_param/shine_color = Color( 1, 0.973, 0.863, 1 )

