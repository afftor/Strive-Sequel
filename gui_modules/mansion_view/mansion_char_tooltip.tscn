[sub_resource type="Shader" id=3]
code = "shader_type canvas_item;

varying float text_y;

void vertex() {
	text_y = VERTEX.y;
}

void fragment() {
	float emphasis = text_y < 22.0 ? 1.0 : (text_y < 44.0 ? 0.78 : 0.56);
	COLOR = texture(TEXTURE, UV) * COLOR;
	COLOR.a *= emphasis;
}
"

