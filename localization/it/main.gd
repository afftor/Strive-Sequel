	ROUGE_WAREHOUSE_CAPTURE_1 = """Improvvisamente senti dei passi dietro di te. Una pattuglia del culto ti taglia la via di fuga.
""",
	ROUGE_WAREHOUSE_CAPTURE_2 = """{color=aqua|— Ehi, chi c'è là!? Abbiamo una spia qui!}

