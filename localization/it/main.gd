	KURO3_DEPTHS_11 = "{color=yellow|Kuro: — Sì. Ora inizia la parte davvero difficile. Potrebbe diventare davvero pericoloso, quindi facciamo del nostro meglio.}",
	KURO3_DUNGEON_1 = """Mentre attraversi i corridoi bui e umidi, Kuro ti ferma improvvisamente. Guardandola perplessa, la vedi indagare su uno dei muri di mattoni.

