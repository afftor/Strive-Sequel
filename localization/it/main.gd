	ACT4_3_EMPIRE_CAPITAL_OPT_ERDYNA_HIDEOUT = "Vai al vecchio nascondiglio di Erdyna.",
	ACT4_3_QUEST_CATACOMB_OPTION_RETURN = "Torna alle porte sigillate.",
	ACT4_3_RED_ROOKS_FORT_NAME = "Vecchio Forte dei Red Rooks",
	ACT4_3_RED_ROOKS_FORT_DESC = "I Red Rooks tengono prigioniera la gente di Erdyna in un vecchio forte vicino ai canali inferiori. Sfonda le difese della banda e raggiungi il loro capo.",
	ACT4_3_ERDYNA_CAPITAL_RETURN_1 = """Percorri appena le strade periferiche prima che un uomo magro e pieno di lividi barcolli fuori da un vicolo e si irrigidisca alla vista di Erdyna.

