	KURO3_DEPTHS_OPTION = "Cerca un seguace di Nixx",
	KURO3_DEPTHS_1 = """Segui Kuro mentre si muove con sicurezza più a fondo nell'insediamento, lungo uno dei sentieri, finché non raggiunge una piccola casa.

