	LOAN_SUCCESS3 = "Presero {custom_text_function=GetLoanSum#2|} oro e se ne andarono rapidamente. Il tuo prossimo pagamento è previsto entro {custom_text_function=GetLoanDay#3|}° giorno e richiederà {custom_text_function=GetLoanSum#3|} oro... A meno che non si possa fare qualcos'altro al riguardo.",
