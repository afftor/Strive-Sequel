	SEARCH_DUNGEON_7_7 = "{color=yellow|— Mi dispiace, non credo di potermi fidare di te, dopotutto. Ana starà meglio lontano da qui, anche se continuerà la sua vita in fuga, anche in povertà.}",
	SEARCH_DUNGEON_15 = """Aire resta in silenzio per un po', mentre emozioni contrastanti le attraversano il viso. Alla fine emette un lungo sospiro.

