	ACT4_SEBASTIAN_REPORT_WAREHOUSE_SOLUTION_5 = """{color=yellow|Sebastian: — Sì, grazie. Ero giunto anch'io a quella spiacevole conclusione. Molto bene, Sindaco [name]. I miei soci useranno il magazzino, e la chiesa di Celena resterà esattamente dov'è.}

