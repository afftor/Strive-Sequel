	SEARCH_DUNGEON_6_2 = "{color=yellow|— Se solo osi toccarla, ti darò la caccia fino ai confini del mondo.}",
	SEARCH_DUNGEON_OPTION_15 = "Bene. Divertiti a marcire in questa cella allora.",
	SEARCH_DUNGEON_6_3 = "Aire non reagisce alle tue parole, ma in qualche modo sembra compiaciuta della tua irritazione.",
	SEARCH_DUNGEON_OPTION_16 = "*Colpiscila*",
	SEARCH_DUNGEON_6_4 = """*Ceffone*
