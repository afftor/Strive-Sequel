	ACT4_ERDYNA_WARD_REPLY_ANY = """{color=yellow|Vaeloria: — Questa è una protezione per rilevare i draghi. Una reliquia dell'epoca in cui il mio lignaggio combatteva quelle creature e la loro stirpe. Risponde solo al sangue che è stata creata per vincolare.}

