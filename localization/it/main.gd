	SEARCH_DUNGEON_OPTION_19 = "In realtà, volevo fare alcune domande.",
	SEARCH_DUNGEON_OPTION_20 = "Andiamo al sodo: raccontaci dove si nasconde la principessa.",
	SEARCH_DUNGEON_OPTION_21 = "Devo andare.",
	SEARCH_DUNGEON_8_1 = "{color=yellow|— Non ti dirò dov'è Anastasia, né a te, né a nessun altro in questa città. A parte questo, non mi dispiace un po' di compagnia.}",
	SEARCH_DUNGEON_8_1_IF_MET = "{color=yellow|— Non ti dirò dov'è Anastasia, né a te, né a nessun altro in questa città. A parte questo, non mi dispiace un po' di compagnia. E so che almeno non sei una cattiva persona.}",
	SEARCH_DUNGEON_OPTION_22 = "Perché sei così fedele alla principessa?",
	SEARCH_DUNGEON_OPTION_23 = "Qual è il tuo ruolo nella ribellione?",
	SEARCH_DUNGEON_OPTION_24 = "Cosa ne pensi di me?",
	SEARCH_DUNGEON_8_7_1 = "{color=yellow|— Beh, mentirei se dicessi che non ti trovo attraente. E suppongo che tu abbia dimostrato di essere migliore anche in combattimento. Vorrei che tu fossi al fianco di Ana invece che di Greg, le cose sarebbero potute andare molto diversamente.}",
	SEARCH_DUNGEON_8_7_2 = "Sai decisamente cavartela in battaglia, e non sembri malvagio come gli altri delle gilde di cui ci hanno parlato. Forse saremmo potuti diventare amici, se le cose fossero andate diversamente.",
	SEARCH_DUNGEON_OPTION_25 = "Per ora è tutto.",
	SEARCH_DUNGEON_7_3 = " ",
	SEARCH_DUNGEON_9 = """{color=yellow|— Mi ha salvata quando ero bambina. Beh, in un certo senso: anche lei era una bambina, intendiamoci.}

{color=yellow|— I banditi avevano ucciso i miei genitori e mi avevano portata al loro accampamento come prigioniera. Poi i banditi furono assaliti a loro volta dagli uomini di Ana. Fui liberata, ma non avevo più un posto dove andare.}

{color=yellow|— Così si offrì di prendermi al suo servizio. Le sue guardie non sembravano d'accordo, ma dal modo in cui si imponeva pareva che non potessero far altro che accettare la sua decisione. Cercavo di non essere d'intralcio e di limitarmi ai miei doveri, ma lei veniva spesso a vedere come stavo e mi trattava come una sorellina, anche se sono solo una popolana, un'elfa, per non dire la sua serva. Da allora le ho giurato fedeltà. Sono pronta a sacrificare la mia vita per lei.}""",
	SEARCH_DUNGEON_OPTION_26 = "Mi dispiace per la tua perdita.",
	SEARCH_DUNGEON_8_2 = "{color=yellow|— Non esserlo, l'ho superato da un pezzo. Sono molto diversa da come ero allora.}",
	SEARCH_DUNGEON_OPTION_27 = "La tua devozione è ammirevole.",
	SEARCH_DUNGEON_8_3 = "{color=yellow|— Non pretendo che tu capisca fino in fondo, ma grazie.}",
	SEARCH_DUNGEON_OPTION_28 = "Avresti potuto fare meglio da sola.",
	SEARCH_DUNGEON_8_4 = "{color=yellow|— No, non capisci... Non avrei dovuto dirtelo, immagino.}",
	SEARCH_DUNGEON_10 = "{color=yellow|— Sto solo servendo Ana. Non me ne potrebbe fregare di meno della politica umana. Per me siete nemici solo per aver ucciso il padre di Ana, indipendentemente da chi fosse. }",
	SEARCH_DUNGEON_OPTION_29 = "Ti rendi conto che puoi essere giustiziata per aver complottato contro le gilde?",
	SEARCH_DUNGEON_8_5 = "{color=yellow|— Anche fosse, non mi importa. C'è sempre qualche motivo per cui qualcuno ti vuole morto, ovunque tu sia e qualunque cosa tu faccia.}",
	SEARCH_DUNGEON_OPTION_30 = "Vorrei che non fossimo finiti su fronti opposti.",
	SEARCH_DUNGEON_8_6 = "{color=yellow|— Siamo in due, ma ormai non possiamo farci niente. Basta però con i sentimentalismi inutili: sono sicura che non sei qui per questo.}",
	SEARCH_DUNGEON_11 = "{color=yellow|— Di nuovo questa storia? Pensavo di essere stata chiara: non dirò nulla a nessuno di voi, in nessun caso.}",
	SEARCH_DUNGEON_OPTION_31 = "Non ti preoccupi per la sua incolumità?",
	SEARCH_DUNGEON_12_1 = "{color=yellow|— Certo che sì, ma... faccio fatica a immaginare un posto peggiore delle mani delle gilde.}",
	SEARCH_DUNGEON_OPTION_32 = "Collaborare potrebbe valerti condizioni di detenzione migliori, o perfino la grazia.",
	SEARCH_DUNGEON_12_2 = "{color=yellow|— Non si tratta di me, idiota. So benissimo che le gilde la giustizieranno una volta trovata, e non ho intenzione di aiutarti ad affrettare la cosa.}",
	SEARCH_DUNGEON_OPTION_33 = "Non fare la sciocca: la ribellione è finita ed è solo questione di tempo prima che la troviamo.",
	SEARCH_DUNGEON_12_3 = "{color=yellow|— Se è così, allora non hai bisogno del mio aiuto, le cose si sistemeranno da sole.}",
	SEARCH_DUNGEON_OPTION_34 = "Se non stai al gioco, gli altri interrogatori non saranno altrettanto gentili...",
	SEARCH_DUNGEON_12_4 = "{color=yellow|— Mettimi alla prova. Non ho intenzione di tradire la sua fiducia, qualunque cosa tu o chiunque altro minacci di farmi.}",
	SEARCH_DUNGEON_OPTION_35 = "Posso prometterti che mi batterò per l'incolumità di Anastasia.",
	SEARCH_DUNGEON_13 = """Aire fa una pausa, riflettendo a lungo sulle tue parole.

{color=yellow|— Sicuramente la tua parola avrebbe un certo peso, e sembra che tu abbia certi privilegi da queste parti, ma posso davvero fidarmi di te? Che motivo avresti per aiutarla?}""",
	SEARCH_DUNGEON_OPTION_36 = "In realtà sono dalla tua parte. Se mi aiuti, la aiuterò a rimanere in vita.",
	SEARCH_DUNGEON_7_4 = "{color=yellow|— Mi dispiace, non ho intenzione di credere a una bugia così evidente.}",
	SEARCH_DUNGEON_OPTION_37 = "Potremmo riportarti nelle terre degli elfi.",
	SEARCH_DUNGEON_7_5 = "{color=yellow|— Sciocchezze: non solo verrei meno al mio dovere, ma dopo tutto questo non è nemmeno lì che voglio stare.}",
	SEARCH_DUNGEON_OPTION_38 = "Possiamo accusarti di aver nascosto un criminale.",
	SEARCH_DUNGEON_7_6 = "{color=yellow|— Posso conviverci; semmai dimostrerebbe ancora di più il valore della mia lealtà.}",
	SEARCH_DUNGEON_OPTION_39 = "Non mi serve altro motivo che farti stare meglio.",
	SEARCH_DUNGEON_14_1 = "{color=yellow|— Belle parole, ma costano poco, vista la mia situazione. Ti aspetti davvero che ci creda?}",
	SEARCH_DUNGEON_OPTION_40 = "Credo che dovremmo fare del nostro meglio per rendere le persone meno infelici.",
	SEARCH_DUNGEON_14_2 = "{color=yellow|— La pensi davvero così..? Questo è ciò in cui crede anche lei. Mi sembra eccessivamente idealistico, però.}",
	SEARCH_DUNGEON_OPTION_41 = "Sul piano politico potrebbe tornare utile.",
	SEARCH_DUNGEON_14_3 = "{color=yellow|— Assolutamente no. La sua esistenza è un pericolo per le gilde e lo sappiamo entrambi. Se la toglieranno di mezzo appena metteranno le mani su di lei.}",
	SEARCH_DUNGEON_OPTION_42 = "Sarebbe un'aggiunta meravigliosa al mio harem",
	SEARCH_DUNGEON_14_4 = """Aire scoppia a ridere.

