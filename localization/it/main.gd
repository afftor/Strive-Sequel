	LOOKING_FOR_PRINCESS_14 = "{color=yellow|— Eh già, cazzo: consideralo il prezzo per avermi aggredito. Prendere o lasciare, non mi interessa.}",
	LOOKING_FOR_PRINCESS_15 = "Come l'ultima volta, il coboldo sparisce in un lampo in uno dei cunicoli, lasciandoti a mani vuote. Converrà tornare un altro giorno.",
	LOOKING_FOR_PRINCESS_16 = """Dopo un po' ritrovi lo stesso coboldo col braccialetto, che sembra essere tornato nello stesso punto.

