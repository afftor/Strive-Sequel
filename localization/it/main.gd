	ACT4_ROAD_RILU_Q1 = "{color=yellow|Rilu: — Mi chiamo Rilu. Temo sia tutto ciò che posso dirti, visto il pessimo stato della mia memoria.}",
	ACT4_ROAD_RILU_Q2 = "{color=yellow|Rilu: — Sei tu o Sebastian. Non mi sembri il tipo dietro a tutta questa faccenda, e sei suo nemico.}",
	ACT4_ROAD_RILU_Q3 = """{color=yellow|Rilu: — Conosci Sebastian, vero? Il negromante ha detto il suo nome, dato che è lui dietro a tutto questo.}

