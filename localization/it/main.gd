	KURO3_DIALOGUE_4_2 = "— Non è vero. Non ho ancora detto una sola bugia qui..",
	KURO3_DIALOGUE_4_OPTION_1 = "Stai ovviamente mentendo. Perché non lo dici e basta?",
	KURO3_DIALOGUE_4_OPTION_2 = "Nascondere quell'informazione è ciò che ti permette di goderti un po' di controllo su di me?",
	KURO3_DIALOGUE_4_OPTION_3 = "Lascia perdere...",
	KURO3_DIALOGUE_5 = """Il sorriso di Kuro si allarga, i suoi occhi brillano di gioia particolare.

