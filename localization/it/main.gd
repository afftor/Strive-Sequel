	WORKERSINTRODUCTION2_1 = """{color=yellow|— Woah, è inaspettato. Il mio onore incontrarti.}

""",
	WORKERSINTRODUCTION2_2 = """{color=yellow|— Ora, guarda la tua lingua, [boy]. Forse ti sei perso un paio d'anni, da quando tutti i senzienti sono stati accettati allo stesso modo dalla legge qui, subito dopo la rivoluzione. È stato allora che sono venuto qui per fare la mia carriera. Sei un proprietario terriero, vero?}

""",
	WORKERSINTRODUCTION2_3 = "{color=yellow|— Scommetto che sei venuto per saperne di più su di noi. Non c'è molto da dire in realtà, siamo le braccia e le gambe del paese. Costruiamo, coltiviamo, realizziamo e forgiamo. Riuscite a immaginare se nessuno se ne prendesse cura? Nemmeno io. Prendiamo ordini di artigianato dai clienti e da altre gilde. Non hai idea di quanta roba i combattenti abbiano bisogno che riforgiamo ogni mese.}",
	WORKERSINTRODUCTION2_4 = "{color=yellow|— Oh, sei di nuovo tu. Ti unirai a noi ora?}",
	WORKERSINTRODUCTION2_5 = "{color=yellow|— Oh, sei di nuovo tu. Come va?}",
	WORKERSINTRODUCTION2_6 = "{color=yellow|— Tutto qui? Dovrei tornare al lavoro.}",
