	ACT4_3_ERDYNA_OLD_HIDEOUT_OPTION_CRUSH = "Li schiacceremo prima che capiscano cosa li ha colpiti.",
	ACT4_3_ERDYNA_OLD_HIDEOUT_OPTION_CAREFUL = "Allora procediamo con cautela. Se vogliono una trappola, la rivolteremo contro di loro.",
	ACT4_3_ERDYNA_OLD_HIDEOUT_OPTION_SORRY = "Mi dispiace, Erdyna. Li riprenderemo.",
	ACT4_3_ERDYNA_OLD_HIDEOUT_MOVE = """{color=yellow|Erdyna: — Posso davvero contare su di te, vero? Capisco perché sei più un capo di quanto lo sia io...}

