	SEARCH_DUNGEON_OPTION_7 = "Vogliamo sapere dove è fuggita la principessa.",
	SEARCH_DUNGEON_OPTION_8 = "Devi pur sapere dove è andata la tua padrona.",
	SEARCH_DUNGEON_OPTION_9 = "Non pensi che collaborare ti renderebbe le cose più facili?",
	SEARCH_DUNGEON_5_1 = "{color=yellow|— Pensi davvero che collaborerei mai con te?}",
	SEARCH_DUNGEON_OPTION_10 = "Perché no? Cosa ti rende così fedele?",
	SEARCH_DUNGEON_5_2 = "{color=yellow|— ...Tu non capiresti, né sprecherò il mio fiato a dirtelo.}",
	SEARCH_DUNGEON_OPTION_11 = "Chissà cosa potrebbe succederti se non collabori?",
	SEARCH_DUNGEON_5_3 = "{color=yellow|— Fa' pure il peggio che puoi. Preferisco morire piuttosto che aiutare quelli come te.}",
	SEARCH_DUNGEON_OPTION_12 = "La principessa se la passerà meglio se collabori.",
	SEARCH_DUNGEON_5_4 = "{color=yellow|— Oh, sono certa che starebbe meglio in qualunque altro posto.}",
