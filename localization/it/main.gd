	PRE_RITUAL_4_1_2 = "Passi i soldi agli schiavisti sorridenti mentre ti portano la ragazza catturata. Hai deciso di non tentare la lotta e di portarla via rapidamente dall'accampamento.",
	PRE_RITUAL_4_2_1 = """{color=green|Successo}

