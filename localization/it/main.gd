	MAGESQUESTIONS_1 = "{color=yellow|— Continua.}",
	MAGESQUESTIONS_2 = """{color=yellow|— Con tutto il rispetto che ho quasi perso, sembra che tu non possieda alcuna vera ricchezza o potere. Temo che non cambierà nulla per noi, che tu ti unisca a noi o meno. Quindi, sono un po' poco entusiasta.}

