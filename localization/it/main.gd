	SERVANTSASKQUESTIONSRETURN = "Questo è tutto.",
	WORKERSINTRODUCTION1 = """Incontri un nano basso e muscoloso che assomiglia a un caposquadra nel suo abbigliamento e nei suoi modi di fare.

{color=yellow|— Sì, amico, non ti ho ancora visto in giro. Il nome è Sigmund. Stai cercando lavoro?}""",
	WORKERSINTRODUCTION1_1 = "Se stai ancora decidendo con chi schierarti, ti forniremo il miglior lavoratore per le tue esigenze.",
	WORKERSINTRODUCTIONREPLY1 = "Sono un nuovo proprietario terriero da queste parti.",
